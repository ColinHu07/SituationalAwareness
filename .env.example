# Defaults are offline, visibly simulated. No model credential enters a client.
HOST=127.0.0.1
PORT=8787
MODEL_MODE=mock
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Optional. When set in live mode, conversation checks go to a fast non-reasoning Grok model.
# Scene checks, tone, learning and transcription stay on Muse. Leave empty to use Muse for everything.
XAI_API_KEY=
XAI_MODEL=grok-4.20-non-reasoning
# REQUIRED in live mode or when binding a non-loopback address. Generate locally:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Enter this separate proxy token in the companion; NEVER enter MUSE_API_KEY there.
COPILOT_PROXY_TOKEN=
API_TIMEOUT_MS=20000
# Published standard 1.3 token prices, USD per million tokens. Recheck docs.
INPUT_PRICE_PER_MILLION=1.25
OUTPUT_PRICE_PER_MILLION=4.25
CACHED_INPUT_PRICE_PER_MILLION=0.15
ASR_PRICE_PER_HOUR=0.18
# grok-4.20-non-reasoning prices as listed by the xAI models API, USD per million tokens. Recheck docs.
XAI_INPUT_PRICE_PER_MILLION=1.25
XAI_OUTPUT_PRICE_PER_MILLION=2.5
XAI_CACHED_INPUT_PRICE_PER_MILLION=0.2
